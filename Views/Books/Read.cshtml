@model ReaderViewModel
@{
    ViewData["Title"] = Model.Chapter.Title;
    var chapter = Model.Chapter;
    var previous = Model.Chapters.Where(c => c.ChapterNumber < chapter.ChapterNumber).OrderByDescending(c => c.ChapterNumber).FirstOrDefault();
    var next = Model.Chapters.Where(c => c.ChapterNumber > chapter.ChapterNumber).OrderBy(c => c.ChapterNumber).FirstOrDefault();
    var signedIn = Model.User is not null;
    var roots = Model.Comments.Where(c => string.IsNullOrEmpty(c.ParentId)).ToList();
    var hasMarginNotes = Model.Comments.Any(c => !string.IsNullOrWhiteSpace(c.ParagraphId));
    var paragraphNotes = Model.Comments
        .Where(c => !string.IsNullOrWhiteSpace(c.ParagraphId))
        .GroupBy(c => c.ParagraphId!)
        .ToDictionary(g => g.Key, g => g.Count());
    var pageCount = Math.Max(1, Model.Pages.Count);
}

<div class="reader-shell" id="reader-shell" data-theme="light" data-chapter-id="@chapter.Id" data-book-slug="@Model.Book.Slug" data-page-count="@pageCount">
    <div class="reader-toolbar">
        <div class="toolbar-row">
            <div class="toolbar-left">
                <a href="/books/@Model.Book.Slug" class="icon-button" aria-label="Back to the book">←</a>
                <div style="min-width:0">
                    <p class="toolbar-book">@Model.Book.Title</p>
                    <p class="toolbar-meta">Chapter @chapter.ChapterNumber · @Model.Book.AuthorName</p>
                </div>
            </div>
            <div class="toolbar-controls">
                <div class="tool-group" role="group" aria-label="Reading layout">
                    <button type="button" data-mode-set="pages" aria-pressed="true" title="Read page by page">Pages</button>
                    <button type="button" data-mode-set="scroll" aria-pressed="false" title="Read the whole chapter">Chapter</button>
                </div>
                <div class="tool-group" role="group" aria-label="Reading theme">
                    <button type="button" data-theme-set="light" aria-pressed="true" title="Light">Light</button>
                    <button type="button" data-theme-set="sepia" aria-pressed="false" title="Sepia">Sepia</button>
                    <button type="button" data-theme-set="dark" aria-pressed="false" title="Dark">Dark</button>
                </div>
                <div class="tool-group" role="group" aria-label="Font size">
                    <button type="button" data-font="decrease" aria-label="Decrease font size">A−</button>
                    <button type="button" data-font="increase" aria-label="Increase font size">A+</button>
                </div>
                <button type="button" class="tool-button" data-serif-toggle aria-pressed="true" title="Toggle typeface">Serif</button>
                <button type="button" class="tool-button" data-margin-toggle aria-pressed="true" title="Toggle margin notes">
                    Margins @(Model.Comments.Count > 0 ? $"({Model.Comments.Count})" : "")
                </button>
            </div>
        </div>
        <div class="toolbar-row">
            <div class="tts-controls">
                <button type="button" class="tts-button" id="tts-play" aria-label="Play narration">▶ Listen</button>
                <button type="button" class="tts-button" id="tts-prev" aria-label="Previous sentence">‹</button>
                <button type="button" class="tts-button" id="tts-next" aria-label="Next sentence">›</button>
                <button type="button" class="tts-button" id="tts-stop" aria-label="Stop narration">■ Stop</button>
                <label class="tts-hint" for="tts-rate">Speed</label>
                <select id="tts-rate" class="field" style="width:auto;height:28px;padding:2px 26px 2px 8px;font-size:.7rem;border-radius:999px">
                    <option value="0.8">0.8×</option>
                    <option value="0.9">0.9×</option>
                    <option value="1" selected>1×</option>
                    <option value="1.15">1.15×</option>
                    <option value="1.3">1.3×</option>
                    <option value="1.5">1.5×</option>
                </select>
            </div>
            <span class="tts-hint">Synced narration follows the text line by line</span>
            @if (!string.IsNullOrWhiteSpace(chapter.AudioUrl))
            {
                <audio controls preload="none" src="@chapter.AudioUrl" style="height:30px;max-width:220px"></audio>
            }
        </div>
    </div>

    <article class="reader-article">
        <header class="reader-head">
            <p class="eyebrow">@Model.Book.Category · Chapter @chapter.ChapterNumber</p>
            <h1>@chapter.Title</h1>
            <p class="reader-byline">
                @Model.Book.AuthorName
                @if (chapter.PublishedAt.HasValue)
                {
                    <text> · @chapter.PublishedAt.Value.ToString("MMM d, yyyy · h:mm tt") UTC</text>
                }
            </p>
        </header>

        <div class="page-nav" id="page-nav">
            <button type="button" class="btn btn-sm" id="page-prev" aria-label="Previous page">← Previous page</button>
            <span class="page-indicator" id="page-indicator">Page 1 of @pageCount</span>
            <button type="button" class="btn btn-sm" id="page-next" aria-label="Next page">Next page →</button>
        </div>

        <div class="reader-layout @(hasMarginNotes ? "with-margins" : "")" id="reader-layout">
            <div class="reader-text" id="reader-text" style="font-size:19px;line-height:1.75">
                @if (Model.Blocks.Count == 0)
                {
                    <p class="muted">This chapter has no readable text yet.</p>
                }
                @foreach (var sheet in Model.Pages)
                {
                    <section class="reader-page" data-page="@sheet.Number" id="page-@sheet.Number" aria-label="Page @sheet.Number" data-page-number="@sheet.Number">
                        @if (sheet.Blocks != null)
                        {
                            foreach (var block in sheet.Blocks)
                            {
                                <p class="reader-block" data-block-id="@block.Id" data-page="@sheet.Number" id="block-@block.Id">
                                    @block.Text
                                    @if (paragraphNotes.TryGetValue(block.Id, out var noteCount))
                                    {
                                        <button type="button" class="note-pill" data-scroll-notes aria-label="@noteCount marginal notes on this paragraph">✎ @noteCount</button>
                                    }
                                </p>
                            }
                        }
                    </section>
                }
            </div>

            <aside class="margin-notes">
                <div class="margin-notes-inner">
                    <p class="margin-title">Margin notes</p>
                    @foreach (var note in Model.Comments.Where(c => !string.IsNullOrWhiteSpace(c.ParagraphId)).Take(6))
                    {
                        <button type="button" class="margin-note" data-margin-target="@note.ParagraphId" data-comment-target="@note.Id">
                            @if (!string.IsNullOrWhiteSpace(note.HighlightedText))
                            {
                                <blockquote>@note.HighlightedText</blockquote>
                            }
                            @note.Content
                            <span class="margin-author">— @EditorialAttribution.For(note)@(note.PageNumber.HasValue ? $" · p.{note.PageNumber}" : "")</span>
                        </button>
                    }
                    <p class="tts-hint">Select any sentence to annotate it.</p>
                </div>
            </aside>
        </div>

        <nav class="reader-nav">
            @if (previous is not null)
            {
                <a class="btn btn-sm" href="/books/@Model.Book.Slug/@previous.ChapterNumber">← Ch. @previous.ChapterNumber</a>
            }
            else
            {
                <span></span>
            }
            <button type="button" class="btn btn-sm" data-compose-open>✎ Leave a note or correction</button>
            @if (next is not null)
            {
                <a class="btn btn-sm" href="/books/@Model.Book.Slug/@next.ChapterNumber">Ch. @next.ChapterNumber →</a>
            }
            else
            {
                <a class="btn btn-sm" href="/books/@Model.Book.Slug">Contents</a>
            }
        </nav>

        <section class="notes-section" id="notes">
            <div class="notes-head">
                <div>
                    <h2>Notes, corrections &amp; contributions</h2>
                    <p>
                        @if (Model.Comments.Count == 0)
                        {
                            <text>Everything posted here goes to the editors for review before it appears.</text>
                        }
                        else
                        {
                            <text>@Model.Comments.Count published @(Model.Comments.Count == 1 ? "note" : "notes") · reviewed by the editors</text>
                        }
                    </p>
                </div>
                <button type="button" class="btn btn-sm" data-compose-open>✎ Add your note</button>
            </div>

            @if (Model.Comments.Count == 0)
            {
                <div class="empty-state" style="padding:40px 20px">
                    <h3 style="font-size:1rem">Nothing on this chapter yet</h3>
                    <p>
                        @if (signedIn)
                        {
                            <text>Be the first to annotate — select a line above or use “Add your note”. The editors review every submission.</text>
                        }
                        else
                        {
                            <text>Sign in with Google to highlight lines, suggest corrections and leave notes for the editors.</text>
                        }
                    </p>
                    @if (!signedIn)
                    {
                        <a href="/?signin=1&amp;next=@Uri.EscapeDataString($"/books/{Model.Book.Slug}/{chapter.ChapterNumber}")" class="btn btn-ghost btn-sm mt-3">Sign in with Google</a>
                    }
                </div>
            }
            else
            {
                <ul class="note-list">
                    @foreach (var comment in roots)
                    {
                        var replies = Model.Comments.Where(c => c.ParentId == comment.Id).ToList();
                        <li class="note-card" id="comment-@comment.Id" data-comment-id="@comment.Id">
                            <div class="note-top">
                                @if (!string.IsNullOrWhiteSpace(comment.AvatarUrl))
                                {
                                    <img class="note-avatar" src="@comment.AvatarUrl" alt="" referrerpolicy="no-referrer" />
                                }
                                else
                                {
                                    <span class="note-avatar-fallback">@EditorialAttribution.Initials(EditorialAttribution.For(comment))</span>
                                }
                                <div style="min-width:0;flex:1">
                                    <div class="note-who">
                                        <strong>@EditorialAttribution.For(comment)</strong>
                                        @if (comment.Kind == "correction")
                                        {
                                            <span class="badge-soft badge-gold">Correction</span>
                                        }
                                        @if (comment.Status != "accepted")
                                        {
                                            <span class="badge-soft badge-forest">Awaiting review</span>
                                        }
                                        @if (comment.PageNumber.HasValue)
                                        {
                                            <span class="badge-soft badge-forest">Page @comment.PageNumber</span>
                                        }
                                        @if (comment.IsContributorSubmission)
                                        {
                                            <span class="badge-soft badge-gold">Contribution</span>
                                        }
                                        @if (comment.IsSpoiler)
                                        {
                                            <span class="badge-soft badge-burgundy">Spoiler</span>
                                        }
                                        <span class="note-time">@comment.CreatedAt.ToString("MMM d, yyyy · h:mm tt") UTC</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(comment.HighlightedText))
                                    {
                                        <blockquote class="note-quote">@comment.HighlightedText</blockquote>
                                    }
                                    <p class="note-content">@comment.Content</p>
                                    <div class="note-actions">
                                        <button type="button" data-upvote="@comment.Id" @(signedIn ? "" : "disabled")>▲ <span>@comment.Upvotes</span></button>
                                        <button type="button" data-reply="@comment.Id" @(signedIn ? "" : "disabled")>Reply</button>
                                        <span class="note-time">@comment.CreatedAt.ToString("MMM d, yyyy · h:mm tt") UTC</span>
                                    </div>
                                </div>
                            </div>

                            @if (replies.Count > 0)
                            {
                                <ul class="note-replies">
                                    @foreach (var reply in replies)
                                    {
                                        <li>
                                            <div class="note-who">
                                                <strong>@reply.Username</strong>
                                                <span class="note-time">@reply.CreatedAt.ToString("MMM d, yyyy · h:mm tt") UTC</span>
                                            </div>
                                            <p class="note-content">@reply.Content</p>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </article>

    <button type="button" class="selection-pop" id="selection-pop" hidden>✎ Annotate selection</button>
</div>

<div class="modal" id="note-modal" hidden>
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-panel modal-md" role="dialog" aria-modal="true" aria-labelledby="note-modal-title">
        <header class="modal-head">
            <div>
                <h2 id="note-modal-title">Leave a note in the margin</h2>
                <p class="muted small">Notes and corrections are reviewed by our editors before they appear.</p>
            </div>
            <button type="button" class="icon-button" data-modal-close aria-label="Close">✕</button>
        </header>
        <form id="note-form" novalidate>
            <div class="modal-body">
                <div class="segmented" role="group" aria-label="Submission type">
                    <label><input type="radio" name="note-kind" value="comment" checked /> <span>Note</span></label>
                    <label><input type="radio" name="note-kind" value="correction" /> <span>Correction</span></label>
                </div>
                <p class="hint" id="note-page-hint">Attached to the current page.</p>

                <blockquote class="note-quote" id="note-quote" hidden></blockquote>
                <div class="mt-3">
                    <label class="label" for="note-content">Your note</label>
                    <textarea class="field" id="note-content" rows="5" maxlength="2000" placeholder="What did this passage make you think about?" data-autofocus></textarea>
                    <div class="row" style="justify-content:space-between">
                        <p class="error-text" id="note-error" hidden></p>
                        <span class="hint" id="note-count">0/2000</span>
                    </div>
                </div>
                <label class="row mt-3" style="align-items:flex-start;font-size:.85rem">
                    <input type="checkbox" id="note-contribution" style="margin-top:4px;accent-color:#2e5748" />
                    <span><strong>Submit as a contribution</strong><span class="hint" style="display:block">Editors can credit you on this book if they accept it.</span></span>
                </label>
                <label class="row mt-2" style="align-items:flex-start;font-size:.85rem">
                    <input type="checkbox" id="note-spoiler" style="margin-top:4px;accent-color:#2e5748" />
                    <span><strong>This contains spoilers</strong><span class="hint" style="display:block">We'll flag it for readers who haven't finished.</span></span>
                </label>
            </div>
            <footer class="modal-foot">
                <button type="button" class="btn btn-quiet" data-modal-close>Cancel</button>
                <button type="submit" class="btn btn-primary" id="note-submit">Submit for review</button>
            </footer>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/reader.js" asp-append-version="true"></script>
}
